{
  "name": "companion-mcp",
  "version": "1.1.0",
  "description": "MCP server for Bitfocus Companion focused on creating and maintaining configuration (pages, buttons, actions, feedbacks, triggers).",
  "type": "module",
  "license": "MIT",
  "author": "Jochen Walter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rA1nm3n/companion-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rA1nm3n/companion-mcp/issues"
  },
  "homepage": "https://github.com/rA1nm3n/companion-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bitfocus",
    "companion",
    "streamdeck",
    "broadcast",
    "av"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/index.js",
  "bin": {
    "companion-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run integration",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "bundle": "npm run build && node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
