      "id": "audiorouteblock",
      "name": "Route audio block",
      "options": [
        {
          "id": "out",
          "type": "dropdown",
          "label": "First Output Channel",
          "default": "dante/channels/1",
          "choicesNote": "Ids 'dante/channels/1..64', 'outputs/1..24/channels/1..8', 'multiviewers/1..2/channels/1..8' (livepremier.js:37-76)",
          "valueType": "string",
          "valuePattern": "^(dante/channels/\\d+|outputs/\\d+/channels/\\d+|multiviewers/\\d+/channels/\\d+)$"
        },
        {
          "id": "in",
          "type": "dropdown",
          "label": "First Input Channel",
          "description": "Tip: Source None virtually expands to the block size",
