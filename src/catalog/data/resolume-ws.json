    {
      "id": "connected-clip-thumbnail",
      "name": "Connected Clip Thumbnail",
      "feedbackType": "advanced",
      "description": "Returns a PNG of the clip thumbnail fetched over HTTP from the Resolume web server (host and HTTP port from the config), scaled to the button image size (default 72x72 when the size is unknown). With \"Selected Layer\" ticked it shows the clip connected on the selected layer (instance.connectedClips). Reading the source: without it, getThumbnail parses a \"column\" option this feedback does not have (NaN), so the clip lookup finds nothing and the feedback returns an empty result (src/feedbacks.ts:90-91, 105).",
      "options": [
        {
          "id": "selected",
          "type": "checkbox",
          "label": "Selected Layer",
          "default": false
        },
