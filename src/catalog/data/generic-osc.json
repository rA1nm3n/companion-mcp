          ],
          "disableAutoExpression": true
        },
        {
          "id": "portId",
          "type": "number",
          "label": "MIDI Port ID (0-255)",
          "default": 0,
          "min": 0,
          "max": 255,
          "integer": true,
          "visibleWhen": "$(options:mode) !== 'raw'",
          "description": "OSC MIDI has a leading \"port\" byte. Leave 0 unless you know your receiver expects something else."
        },
        {
          "id": "channel",
          "type": "number",
          "label": "Channel (1-16)",
          "default": 1,
          "min": 1,
          "max": 16,
          "integer": true,
          "visibleWhen": "$(options:mode) !== 'raw'"
