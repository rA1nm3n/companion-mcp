          "description": "Note On/Off: Velocity (0-127). CC: Value (0-127). Poly Aftertouch: Pressure (0-127)."
        },
        {
          "id": "pitch",
          "type": "number",
          "label": "Pitch Bend (center 0; range -8192..8191)",
