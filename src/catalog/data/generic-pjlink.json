      "id": "inputToggle",
      "name": "Switch Projector Input",
      "options": [
        {
          "id": "inputNum",
          "type": "dropdown",
          "label": "Select input",
          "choicesNote": "Filled at runtime from the projector. Starts with the built-in list CONFIG.INPUTS (11 RGB1, 12 RGB2, 31 DVI-D, 32 HDMI, 33 Digital link, 34 SDI1, 35 SDI2, 52 LAN, 56 HDBaseT; choices.js), then replaced by the inputs the projector reports with INST (Class 1: generated labels like 'RGB-1 (11)'; Class 2: names from INNM, label 'name (id)'). Ids are strings of the PJLink input number (class digit + number).",
          "valueType": "string"
        }
      ],
      "provenance": {
        "file": "pjlink.js",
        "line": 745
      },
      "description": "Sends %1INPT <inputNum>. The source has no default for this option (the default line is commented out)."
