            {
              "id": "1",
              "label": "On"
            },
            {
              "id": "2",
              "label": "Toggle"
            }
          ]
        }
      ],
      "provenance": {
        "file": "pjlink.js",
        "line": 702
      },
      "description": "Sends %1POWR only while the stored power state is '0' or '1' (not while cooling or warming up). Toggle (2) inverts the stored state."
